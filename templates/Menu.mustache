<nav id="{{id}}" class="{{class}} aurelia-portlet" {{{html-tooltip}}} aria-labelledby="{{id}}-label">
    {{{html-before-portal}}}
    <h2 id="{{id}}-label" class="aurelia-portlet-label" {{{html-user-language-attributes}}}>{{label}}</h2>
    <div class="aurelia-portlet-body">
        <ul class="aurelia-portlet-list" {{{html-user-language-attributes}}}>
            {{{html-items}}}
        </ul>
        {{{html-after-portal}}}
    </div>
</nav>
