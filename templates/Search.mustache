<form class="aurelia-search-form" action="{{form-action}}" id="searchform" method="get" role="search">
    <input type="hidden" name="title" value="{{page-title}}">
    <label class="aurelia-search-label" for="searchInput">{{msg-search}}</label>
    <span class="aurelia-search-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
    {{{html-input}}}
    {{{html-button-search}}}
    {{{html-button-search-fallback}}}
</form>
